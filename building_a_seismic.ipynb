    "handcalcs.set_option(\"custom_symbols\", {\"star\": \"^*\", \"__\": \",\"})\n",
    "handcalcs.set_option(\"greek_exclusions\", [\"psi\"])\n",
    "handcalcs.set_option(\"display_precision\", 4)\n",
    "handcalcs.set_option(\"param_columns\", 1)\n",
    "handcalcs.set_option(\"latex_block_start\", \"\\\\begin{equation*}\")\n",
    "handcalcs.set_option(\"latex_block_end\", \"\\\\end{equation*}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "036e844d",
   "metadata": {},
   "source": [
    "# Effective Seismic Weight Calculation"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "99697509",
   "metadata": {},
   "source": [
    "We calculate the effective seismic weight with unit weights and square footages."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "97a451c7",
   "metadata": {},
   "source": [
    "## Unit Weights"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0072beff",
   "metadata": {},
   "source": [
    "Weights will be assigned with area unit weights."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f1ee734c",
   "metadata": {},
   "outputs": [],
   "source": [
    "set_params_columns(4)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "2e65f9e5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "\\begin{equation*}\n",
       "\\begin{aligned}\n",
       "U_{corridor} &= 0.035\\ \\mathrm{ksf} \\; \n",
       " &U_{floor} &= 0.035\\ \\mathrm{ksf} \\; \n",
       " &U_{roof} &= 0.025\\ \\mathrm{ksf} \\; \n",
       " &U_{wall} &= 0.012\\ \\mathrm{ksf} \\; \n",
       "\\\\\n",
       "\\end{aligned}\n",
       "\\end{equation*}"
      ],
      "source": [
        "%%render params\n",
        "U_corridor = 35 / 1000 * ksf\n",
        "U_floor = 30 / 1000 * ksf\n",
        "U_roof = 25 / 1000 * ksf\n",
        "U_wall = 12 / 1000 * ksf"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "009d6ac6",
      "metadata": {},
      "source": [
        "## Building Geometry"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "2669e70c",
      "metadata": {},
      "source": [
        "The lengths and widths of the weight areas are consistent across levels 2, 3, and 4."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "0a9fdf5e",
      "metadata": {},
      "outputs": [],
      "source": [
        "set_params_columns(5)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "d60fed0d",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "L_{floor} &= 230\\ \\mathrm{ft} \\; \n",
              " &w_{floor} &= 30.75\\ \\mathrm{ft} \\; \n",
              " &L_{corridor} &= 230\\ \\mathrm{ft} \\; \n",
              " &w_{corridor} &= 5.5\\ \\mathrm{ft} \\; \n",
              " &w_{building} &= 67\\ \\mathrm{ft} \\; \n",
              "\\\\\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render params\n",
        "L_floor = 230 * ft\n",
        "w_floor = (30 + 9 / 12) * ft\n",
        "L_corridor = 230 * ft\n",
        "w_corridor = 5.5 * ft\n",
        "w_building = (w_floor * 2) + w_corridor"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "d93d3304",
      "metadata": {},
      "source": [
        "The wall heights vary across the levels."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "id": "0e8fa047",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "h_{wall,1} &= 11.5\\ \\mathrm{ft} \\; \n",
              " &h_{wall,2} &= 10.5\\ \\mathrm{ft} \\; \n",
              " &h_{wall,3} &= 10.5\\ \\mathrm{ft} \\; \n",
              " &h_{wall,4} &= 10\\ \\mathrm{ft} \\;\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render params\n",
        "h_wall__1 = 11.5 * ft\n",
        "h_wall__2 = 10.5 * ft\n",
        "h_wall__3 = 10.5 * ft\n",
        "h_wall__4 = 10 * ft"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "dce8136e",
      "metadata": {},
      "source": [
        "There is a small jog in the building floorplan. This does not affect the area, but the perimeter will be longer."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "id": "080410ac",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "L_{jog} &= 5\\ \\mathrm{ft} \\;\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render params\n",
        "L_jog = 5 * ft"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 10,
      "id": "0765c7e2",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "P_{wall} &= \\left( 2 \\cdot L_{floor} \\right) + \\left( 2 \\cdot w_{building} \\right) + \\left( 2 \\cdot L_{jog} \\right) \\\\&= \\left( 2 \\cdot 230\\ \\mathrm{ft} \\right) + \\left( 2 \\cdot 67\\ \\mathrm{ft} \\right) + \\left( 2 \\cdot 5\\ \\mathrm{ft} \\right) \\\\&= 604\\ \\mathrm{ft}  \\\\\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "P_wall = (2 * L_floor) + (2 * w_building) + (2 * L_jog)"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "19584b32",
      "metadata": {},
      "source": [
        "Areas can now be calculated. Note that the areas of the walls are the actual wall areas; they have not been distributed to each floor based on tributary area, yet."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "id": "700cb0fe",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "A_{floor} &= 2 \\cdot \\left( L_{floor} \\cdot w_{floor} \\right)  = 2 \\cdot \\left( 230\\ \\mathrm{ft} \\cdot 30.75\\ \\mathrm{ft} \\right) &= 1.414e+04\\ \\mathrm{ft}^{2}  \n",
              "\\\\\n",
              "A_{corridor} &= L_{corridor} \\cdot w_{corridor}  = 230\\ \\mathrm{ft} \\cdot 5.5\\ \\mathrm{ft} &= 1265\\ \\mathrm{ft}^{2}  \n",
              "\\\\\n",
              "A_{level} &= L_{floor} \\cdot w_{building}  = 230\\ \\mathrm{ft} \\cdot 67\\ \\mathrm{ft} &= 1.541e+04\\ \\mathrm{ft}^{2}  \n",
              "\\\\\n",
              "A_{wall,1} &= h_{wall,1} \\cdot P_{wall}  = 11.5\\ \\mathrm{ft} \\cdot 604\\ \\mathrm{ft} &= 6946\\ \\mathrm{ft}^{2}  \n",
              "\\\\\n",
              "A_{wall,2} &= h_{wall,2} \\cdot P_{wall}  = 10.5\\ \\mathrm{ft} \\cdot 604\\ \\mathrm{ft} &= 6342\\ \\mathrm{ft}^{2}  \n",
              "\\\\\n",
              "A_{wall,3} &= h_{wall,3} \\cdot P_{wall}  = 10.5\\ \\mathrm{ft} \\cdot 604\\ \\mathrm{ft} &= 6342\\ \\mathrm{ft}^{2}  \n",
              "\\\\\n",
              "A_{wall,4} &= h_{wall,4} \\cdot P_{wall}  = 10\\ \\mathrm{ft} \\cdot 604\\ \\mathrm{ft} &= 6040\\ \\mathrm{ft}^{2}  \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render \n",
        "A_floor = 2 * (L_floor * w_floor)\n",
        "# This is a slight overestimate as the corridor doesn't stretch the full length of the building\n",
        "A_corridor = L_corridor * w_corridor\n",
        "A_level = L_floor * w_building\n",
        "A_wall__1 = h_wall__1 * P_wall\n",
        "A_wall__2 = h_wall__2 * P_wall\n",
        "A_wall__3 = h_wall__3 * P_wall\n",
        "A_wall__4 = h_wall__4 * P_wall"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "225dcddb",
      "metadata": {},
      "source": [
        "## Component Weights"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "371a6e23",
      "metadata": {},
      "source": [
        "The typical floor and corridor weights are"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 12,
      "id": "0629c452",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "W_{floor,typ} &= U_{floor} \\cdot A_{floor}  = 0.03\\ \\mathrm{ksf} \\cdot 1.414e+04\\ \\mathrm{ft}^{2} &= 424.4\\ \\mathrm{kip}  \n",
              "\\\\\n",
              "W_{corridor,typ} &= U_{corridor} \\cdot A_{corridor}  = 0.035\\ \\mathrm{ksf} \\cdot 1265\\ \\mathrm{ft}^{2} &= 44.28\\ \\mathrm{kip}  \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "W_floor__typ = U_floor * A_floor\n",
        "W_corridor__typ = U_corridor * A_corridor"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "3cb56812",
      "metadata": {},
      "source": [
        "This applies to levels 2, 3, and 4."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 13,
      "id": "9efebe53",
      "metadata": {},
      "outputs": [],
      "source": [
        "set_params_columns(3)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 14,
      "id": "20ae9d1e",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "W_{floor,2} &= 424.4\\ \\mathrm{kip} \\; \n",
              " &W_{floor,3} &= 424.4\\ \\mathrm{kip} \\; \n",
              " &W_{floor,4} &= 424.4\\ \\mathrm{kip} \\; \n",
              "\\\\\n",
              " W_{corridor,2} &= 44.28\\ \\mathrm{kip} \\; \n",
              " &W_{corridor,3} &= 44.28\\ \\mathrm{kip} \\; \n",
              " &W_{corridor,4} &= 44.28\\ \\mathrm{kip} \\; \n",
              "\\\\\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render params\n",
        "W_floor__2 = W_floor__typ\n",
        "W_floor__3 = W_floor__typ\n",
        "W_floor__4 = W_floor__typ\n",
        "W_corridor__2 = W_corridor__typ\n",
        "W_corridor__3 = W_corridor__typ\n",
        "W_corridor__4 = W_corridor__typ"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "e5f8b5a1",
      "metadata": {},
      "source": [
        "The roof weight is"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 15,
      "id": "c8c184f7",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "W_{roof} &= U_{roof} \\cdot A_{level}  = 0.025\\ \\mathrm{ksf} \\cdot 1.541e+04\\ \\mathrm{ft}^{2} &= 385.2\\ \\mathrm{kip}  \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "W_roof = U_roof * A_level"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "04277ab6",
      "metadata": {},
      "source": [
        "The exterior walls are divided in half to the floor above and below."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 16,
      "id": "7333ce7f",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "W_{wall,2} &= U_{wall} \\cdot \\left( \\frac{ A_{wall,2} }{ 2 } + \\frac{ A_{wall,1} }{ 2 } \\right)  = 0.012\\ \\mathrm{ksf} \\cdot \\left( \\frac{ 6342\\ \\mathrm{ft}^{2} }{ 2 } + \\frac{ 6946\\ \\mathrm{ft}^{2} }{ 2 } \\right) &= 79.73\\ \\mathrm{kip}  \n",
              "\\\\\n",
              "W_{wall,3} &= U_{wall} \\cdot \\left( \\frac{ A_{wall,3} }{ 2 } + \\frac{ A_{wall,2} }{ 2 } \\right)  = 0.012\\ \\mathrm{ksf} \\cdot \\left( \\frac{ 6342\\ \\mathrm{ft}^{2} }{ 2 } + \\frac{ 6342\\ \\mathrm{ft}^{2} }{ 2 } \\right) &= 76.1\\ \\mathrm{kip}  \n",
              "\\\\\n",
              "W_{wall,4} &= U_{wall} \\cdot \\left( \\frac{ A_{wall,4} }{ 2 } + \\frac{ A_{wall,3} }{ 2 } \\right)  = 0.012\\ \\mathrm{ksf} \\cdot \\left( \\frac{ 6040\\ \\mathrm{ft}^{2} }{ 2 } + \\frac{ 6342\\ \\mathrm{ft}^{2} }{ 2 } \\right) &= 74.29\\ \\mathrm{kip}  \n",
              "\\\\\n",
              "W_{wall,roof} &= U_{wall} \\cdot \\left( \\frac{ A_{wall,4} }{ 2 } \\right)  = 0.012\\ \\mathrm{ksf} \\cdot \\left( \\frac{ 6040\\ \\mathrm{ft}^{2} }{ 2 } \\right) &= 36.24\\ \\mathrm{kip}  \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "W_wall__2 = U_wall * (A_wall__2 / 2 + A_wall__1 / 2)\n",
        "W_wall__3 = U_wall * (A_wall__3 / 2 + A_wall__2 / 2)\n",
        "W_wall__4 = U_wall * (A_wall__4 / 2 + A_wall__3 / 2)\n",
        "W_wall__roof = U_wall * (A_wall__4 / 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "e827bae6",
      "metadata": {},
      "source": [
        "## Level Weights"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "d9117775",
      "metadata": {},
      "source": [
        "Each level's weight is"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 17,
      "id": "7299c2c5",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "W_{level,2} &= W_{floor,2} + W_{corridor,2} + W_{wall,2}  = 424.4\\ \\mathrm{kip} + 44.28\\ \\mathrm{kip} + 79.73\\ \\mathrm{kip} &= 548.4\\ \\mathrm{kip}  \n",
              "\\\\\n",
              "W_{level,3} &= W_{floor,3} + W_{corridor,3} + W_{wall,3}  = 424.4\\ \\mathrm{kip} + 44.28\\ \\mathrm{kip} + 76.1\\ \\mathrm{kip} &= 544.7\\ \\mathrm{kip}  \n",
              "\\\\\n",
              "W_{level,4} &= W_{floor,4} + W_{corridor,4} + W_{wall,4}  = 424.4\\ \\mathrm{kip} + 44.28\\ \\mathrm{kip} + 74.29\\ \\mathrm{kip} &= 542.9\\ \\mathrm{kip}  \n",
              "\\\\\n",
              "W_{level,roof} &= W_{roof} + W_{wall,roof}  = 385.2\\ \\mathrm{kip} + 36.24\\ \\mathrm{kip} &= 421.5\\ \\mathrm{kip}  \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render \n",
        "W_level__2 = W_floor__2 + W_corridor__2 + W_wall__2\n",
        "W_level__3 = W_floor__3 + W_corridor__3 + W_wall__3\n",
        "W_level__4 = W_floor__4 + W_corridor__4 + W_wall__4\n",
        "# be sure to add the weight of the truss later\n",
        "W_level__roof = W_roof + W_wall__roof"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "42f52114",
      "metadata": {},
      "source": [
        "## Total Weight"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "0d90c59c",
      "metadata": {},
      "source": [
        "The total weight of the structure is"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "id": "b27b25ea",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "W_{total} &= W_{level,2} + W_{level,3} + W_{level,4} + W_{level,roof} \\\\&= 548.4\\ \\mathrm{kip} + 544.7\\ \\mathrm{kip} + 542.9\\ \\mathrm{kip} + 421.5\\ \\mathrm{kip} \\\\&= 2057\\ \\mathrm{kip}  \\\\\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render long\n",
        "W_total = W_level__2 + W_level__3 + W_level__4 + W_level__roof"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "e4839299",
      "metadata": {},
      "source": [
        "# Seismic Equivalent Lateral Force (ELF) Analysis"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "2cc51d15",
      "metadata": {},
      "source": [
        "We will be using the equivalent lateral force method prescribed by ASCE 7-16 Section 12.8. We will envelope the forces with a fully flexible diaphragm assumption and a fully rigid diaphragm assumption."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "10dd47ab",
      "metadata": {},
      "source": [
        "## Seismic Parameters"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 19,
      "id": "c66310d2",
      "metadata": {},
      "outputs": [],
      "source": [
        "set_params_columns(6)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 20,
      "id": "a00c6c7a",
      "metadata": {},
      "outputs": [],
      "source": [
        "S_S = 0.887  # g\n",
        "S_1 = 0.410  # g\n",
        "seismic_params = SeismicParameters(\n",
        "    s_1=S_1, s_s=S_S, risk_category=RiskCategory.II, site_class=SiteClass.D\n",
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "790ab839",
      "metadata": {},
      "source": [
        "Seismic design parameters are obtained from the geotech report and ASCE 7-16 Sec. 11 and 12."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "id": "416af1b9",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "R &= 6.5 \\; \n",
              " &\\Omega_{0} &= 3 \\; \n",
              " &C_{d} &= 4 \\; \n",
              " &\\rho &= 1 \\;\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render params\n",
        "R = 6.5\n",
        "Omega_0 = 3.0\n",
        "C_d = 4.0\n",
        "rho = 1.0"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "id": "05ab1752",
      "metadata": {},
      "outputs": [],
      "source": [
        "set_params_columns(5)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 23,
      "id": "0764bca4",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "I_{e} &= 1 \\; \n",
              " &S_{S} &= 0.887 \\; \\;\\textrm{(g)}\n",
              " &S_{1} &= 0.41 \\; \\;\\textrm{(g)}\n",
              " &F_{a} &= 1.145 \\; \n",
              " &F_{v} &= 1.89 \\; \n",
              "\\\\\n",
              " S_{MS} &= 1.016 \\; \\;\\textrm{(g)}\n",
              " &S_{M1} &= 0.7749 \\; \\;\\textrm{(g)}\n",
              " &S_{DS} &= 0.6772 \\; \\;\\textrm{(g)}\n",
              " &S_{D1} &= 0.5166 \\; \\;\\textrm{(g)}\n",
              " &\\mathrm{SDC} &= D \\; \n",
              "\\\\\n",
              " C_{u} &= 1.4 \\; \n",
              " &T_{L} &= 16 \\; \\;\\textrm{(s)}\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render params\n",
        "I_e = seismic_params.i_e\n",
        "S_S = seismic_params.s_s  # g\n",
        "S_1 = seismic_params.s_1  # g\n",
        "F_a = seismic_params.f_a\n",
        "F_v = seismic_params.f_v\n",
        "S_MS = seismic_params.s_ms  # g\n",
        "S_M1 = seismic_params.s_m1  # g\n",
        "S_DS = seismic_params.s_ds  # g\n",
        "S_D1 = seismic_params.s_d1  # g\n",
        "SDC = seismic_params.sdc\n",
        "C_u = 1.4\n",
        "T_L = 16  # s"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "6e20a103",
      "metadata": {},
      "source": [
        "## Base Shear\n",
        "\n",
        "We must calculate the period"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 24,
      "id": "15a221c3",
      "metadata": {},
      "outputs": [],
      "source": [
        "set_params_columns(1)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 25,
      "id": "10b033d6",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "&h_{top,roof} &= 57.67\\ \\mathrm{ft} \\; \n",
              "\\\\\n",
              " &h_{bottom,roof} &= 45.5\\ \\mathrm{ft} \\; \n",
              "\\\\\n",
              " &h_{n} &= 51.58\\ \\mathrm{ft} \\; \\;\\textrm{(ASCE 7-16 Sec. 11.2)}\n",
              "\\\\\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render params\n",
        "h_top__roof = (57 + 8 / 12) * ft\n",
        "h_bottom__roof = 45.5 * ft\n",
        "h_n = np.mean([h_top__roof, h_bottom__roof])  # ASCE 7-16 Sec. 11.2"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 26,
      "id": "5cb687c9",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "h_{n,check} &= 51.6 ft \\leq 65 ft \\quad \\textbf{\\color{OK}OK}\\ {\\color{OK}\\checkmark} \\; \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "h_n__check = check_value(h_n, 65 * ft, \"leq\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "624d63ba",
      "metadata": {},
      "source": [
        "We will approximate the building period."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 27,
      "id": "a338a3ab",
      "metadata": {},
      "outputs": [],
      "source": [
        "h_n = float(h_n)  # to prevent weirdness with units"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 28,
      "id": "3e22dac4",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "C_{t} &= 0.02 \\; \\;\\textrm{(ASCE 7-16 Table 12.8-2)}\n",
              "\\\\\n",
              "x &= 0.75 \\; \\;\\textrm{(ASCE 7-16 Table 12.8-2)}\n",
              "\\\\\n",
              "T_{a} &= C_{t} \\cdot \\left( h_{n} \\right) ^{ x }  = 0.02 \\cdot \\left( 51.58 \\right) ^{ 0.75 } &= 0.385 \\; \\;\\textrm{(ASCE 7-16 Eq. 12.8-7)}\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "C_t = 0.02  # ASCE 7-16 Table 12.8-2\n",
        "x = 0.75  # ASCE 7-16 Table 12.8-2\n",
        "T_a = C_t * h_n**x  # ASCE 7-16 Eq. 12.8-7"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "8d8b477d",
      "metadata": {},
      "source": [
        "Because we are not using an automated analysis software, we can make the following assumption:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 29,
      "id": "703ff2a3",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "T &= 0.385 \\; \\;\\textrm{(ASCE 7-16 Sec. 12.8.2)}\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "T = T_a  # ASCE 7-16 Sec. 12.8.2"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "ba19d8b3",
      "metadata": {},
      "source": [
        "With the period, we can calculate the seismic response coefficient."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 30,
      "id": "462ecdac",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "C_{s} &= \\frac{ S_{DS} }{ \\frac{ R }{ I_{e} } }  = \\frac{ 0.6772 }{ \\frac{ 6.5 }{ 1 } } &= 0.1042 \\; \\;\\textrm{(ASCE 7-16 Eq. 12.8-2)}\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "C_s = S_DS / (R / I_e)  # ASCE 7-16 Eq. 12.8-2"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "31fbb028",
      "metadata": {},
      "source": [
        "We must check that $C_s$ does not exceed:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 31,
      "id": "d0af5c9e",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "\\hspace{-\\mathindent}\\span\\text{Since, } T \\leq T_{L} \\rightarrow \\left( 0.385 \\leq 16 \\right) : \\; \\;\\textrm{(ASCE 7-16 Sec. 12.8.1.1)} \\\\\n",
              "C_{s,check,max} &= \\frac{ S_{D1} }{ T \\cdot \\left( \\frac{ R }{ I_{e} } \\right) } \\\\&= \\frac{ 0.5166 }{ 0.385 \\cdot \\left( \\frac{ 6.5 }{ 1 } \\right) } \\\\&= 0.104 \\leq 0.206 \\quad \\textbf{\\color{OK}OK}\\ {\\color{OK}\\checkmark}  \\\\\n",
              "\\\\\n",
              "C_{s,check,max} &= 0.104 \\leq 0.206 \\quad \\textbf{\\color{OK}OK}\\ {\\color{OK}\\checkmark} \\; \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render long\n",
        "# fmt: off\n",
        "if T <= T_L:  C_s__check__max = S_D1 / (T * (R / I_e));              C_s__check__max = check_value(C_s, C_s__check__max, \"leq\")  # ASCE 7-16 Sec. 12.8.1.1\n",
        "elif T > T_L: C_s__check__max = (S_D1 * T_L) / (T**2 * (R / I_e));   C_s__check__max = check_value(C_s, C_s__check__max, \"leq\")  # ASCE 7-16 Sec. 12.8.1.1\n",
        "# fmt: on"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "d704b91e",
      "metadata": {},
      "source": [
        "And we must also check that $C_s$ is not less than:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 32,
      "id": "6940c171",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "C_{s,check,min,1} &= 0.044 \\cdot S_{DS} \\cdot I_{e}  = 0.044 \\cdot 0.6772 \\cdot 1 &= 0.0298 \\; \\;\\textrm{(ASCE 7-16 Eq. 12.8-5)}\n",
              "\\\\\n",
              "C_{s,check,min} &= 0.104 \\geq 0.0298 \\quad \\textbf{\\color{OK}OK}\\ {\\color{OK}\\checkmark} \\; \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "C_s__check__min__1 = 0.044 * S_DS * I_e  # ASCE 7-16 Eq. 12.8-5\n",
        "C_s__check__min = check_value(C_s, C_s__check__min__1, \"geq\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "c8787070",
      "metadata": {},
      "source": [
        "as well as:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 33,
      "id": "9fac808c",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "C_{s,check,min} &= 0.104 \\geq 0.01 \\quad \\textbf{\\color{OK}OK}\\ {\\color{OK}\\checkmark} \\; \\;\\textrm{(ASCE 7-16 Eq. 12.8-5)}\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "C_s__check__min = check_value(C_s, 0.01, \"geq\")  # ASCE 7-16 Eq. 12.8-5"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "055c9f8d",
      "metadata": {},
      "source": [
        "and finally:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 34,
      "id": "0f774b2a",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "\\hspace{-\\mathindent}\\span\\text{Since, } S_{1} \\lt 0.6 \\rightarrow \\left( 0.41 \\lt 0.6 \\right) : \\; \\;\\textrm{(ASCE 7-16 Eq. 12.8-6)} \\\\\n",
              "C_{s,check,min} &= \\text{skipping check} \\; \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "# fmt: off\n",
        "if S_1 >= 0.6:  C_s__check__min__3 = 0.5 * S_1 / (R / I_e); C_s__check__min = check_value(C_s, C_s__check__min__3, \"geq\")  # ASCE 7-16 Eq. 12.8-6\n",
        "elif S_1 < 0.6: C_s__check__min = \"\\\\text{skipping check}\"  # ASCE 7-16 Eq. 12.8-6\n",
        "# fmt: on"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "101db052",
      "metadata": {},
      "source": [
        "And now, we can calculate the base shear, $V$"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 35,
      "id": "26485825",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "V &= C_{s} \\cdot W_{total}  = 0.1042 \\cdot 2057\\ \\mathrm{kip} &= 214.4\\ \\mathrm{kip} \\; \\;\\textrm{(ASCE 7-16 Eq. 12.8-1)}\n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "V = C_s * W_total  # ASCE 7-16 Eq. 12.8-1"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fbfb545b",
      "metadata": {},
      "source": [
        "## Distribute the seismic forces"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "0e4fca58",
      "metadata": {},
      "source": [
        "With the base shear calculated, we must now distribute the base shear on each level.\n",
        "\n",
        "First, we must calculate the structural period exponent, $k$."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 36,
      "id": "83a09245",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\begin{equation*}\n",
              "\\begin{aligned}\n",
              "\\hspace{-\\mathindent}\\span\\text{Since, } T \\leq 0.5 \\rightarrow \\left( 0.385 \\leq 0.5 \\right) :   \\\\\n",
              "k &= 1 \\; \n",
              "\\end{aligned}\n",
              "\\end{equation*}"
            ],
            "text/plain": [
              "<IPython.core.display.Latex object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "%%render\n",
        "# fmt: off\n",
        "if T <= 0.5: k = 1\n",
        "elif T >= 2.5: k = 2\n",
        "elif T > 0.5 and T < 2.5: k = 1 + ((T - 0.5) * (2 - 1)) / (2.5 - 0.5)\n",
        "# fmt: on"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "8ef874e5",
      "metadata": {},
      "source": [
        "Now, we can distribute the forces per floor,"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "5a1bdd5e",
      "metadata": {},
      "source": [
        "$$\n",
        "F_x = C_{vx} V\\;\\;\\text{(ASCE 7-16 Eq. 12.8-11)}\n",
        "$$"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "b60145ae",
      "metadata": {},
      "source": [
        "As well as cumulatively from roof to ground."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "23b5cac1",
      "metadata": {},
      "source": [
        "$$\n",
        "V_x = \\sum_{i=x}^n F_i\\;\\; \\text{(ASCE 7-16 Eq. 12.8-11)}\n",
        "$$"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 37,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load in basic data\n",
        "seismic_loads = pd.DataFrame(\n",
        "    {\n",
        "        \"Level\": [\"Ground\", \"Level 2\", \"Level 3\", \"Level 4\", \"Roof\"],\n",
        "        \"floor_height\": [\n",
        "            float(h_wall__1),\n",
        "            float(h_wall__2),\n",
        "            float(h_wall__3),\n",
        "            float(h_wall__4),\n",
        "            0,\n",
        "        ],\n",
        "        \"floor_weight\": [\n",
        "            0,\n",
        "            float(W_level__2),\n",
        "            float(W_level__3),\n",
        "            float(W_level__4),\n",
        "            float(W_level__roof),\n",
        "        ],\n",
        "    },\n",
        ")\n",
        "seismic_loads = seismic_loads.set_index(\"Level\")\n",
        "\n",
        "# Calc cumulative elevation\n",
        "elevations = [0]\n",
        "for height in seismic_loads.floor_height[:-1]:\n",
        "    elevations.append(height + elevations[-1])\n",
        "seismic_loads.insert(2, \"elevation\", elevations)\n",
        "\n",
        "# Calc coefficients and story forces ASCE 7-16 Eq. 12.8-11 and 12.8-12\n",
        "seismic_loads[\"wxhxk\"] = seismic_loads.floor_weight * seismic_loads.elevation ** float(\n",
        "    k\n",
        ")\n",
        "cumulative_wxhxk = seismic_loads.wxhxk.sum()\n",
        "seismic_loads[\"C_vx\"] = seismic_loads.wxhxk / cumulative_wxhxk\n",
        "seismic_loads[\"F_x\"] = seismic_loads.C_vx * float(V)\n",
        "\n",
        "# Calc story shear forces ASCE 7-16 Eq. 12.8-13\n",
        "story_shears = [0]\n",
        "for shear in reversed(list(seismic_loads.F_x[1:])):\n",
        "    story_shears.insert(0, shear + story_shears[0])\n",
        "seismic_loads[\"V_x\"] = story_shears\n",
        "\n",
        "# Calc overturning moments\n",
        "floor_moments = seismic_loads.V_x * seismic_loads.floor_height\n",
        "overturning_moments = [0]\n",
        "for floor_moment in reversed(list(floor_moments[:-1])):\n",
        "    overturning_moments.insert(0, overturning_moments[0] + floor_moment)\n",
        "seismic_loads[\"OTM\"] = overturning_moments"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 38,
      "id": "3709a4f9",
      "metadata": {},
      "outputs": [],
      "source": [
        "# Rename columns for display with LaTeX formatting for units and subscripts/superscripts\n",
        "column_name_map = {\n",
        "    \"floor_height\": \"$h_{floor}$ [ft]\",\n",
        "    \"floor_weight\": \"$w_x$ [kip]\",\n",
        "    \"elevation\": \"$h_x$ [ft]\",\n",
        "    \"wxhxk\": \"$w_x h_x^k$\",\n",
        "    \"C_vx\": \"$C_{vx}$\",\n",
        "    \"F_x\": \"$F_x$ [kip]\",\n",
        "    \"V_x\": \"$V_x$ [kip]\",\n",
        "    \"OTM\": \"OTM [kip-ft]\",\n",
        "}\n",
        "df_display = seismic_loads.copy()\n",
        "df_display.rename(columns=column_name_map, errors=\"raise\", inplace=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "0833a292",
      "metadata": {},
      "source": [
        "Calculating for each floor leads to the following \\autoref{tab:seismic_forces_calculation_table}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 39,
      "id": "ea4d464b",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/html": [
              "<div>\n",
              "<style scoped>\n",
              "    .dataframe tbody tr th:only-of-type {\n",
              "        vertical-align: middle;\n",
              "    }\n",
              "\n",
              "    .dataframe tbody tr th {\n",
              "        vertical-align: top;\n",
              "    }\n",
              "\n",
              "    .dataframe thead th {\n",
              "        text-align: right;\n",
              "    }\n",
              "</style>\n",
              "<table border=\"1\" class=\"dataframe\">\n",
              "  <thead>\n",
              "    <tr style=\"text-align: right;\">\n",
              "      <th></th>\n",
              "      <th>$h_{floor}$ [ft]</th>\n",
              "      <th>$w_x$ [kip]</th>\n",
              "      <th>$h_x$ [ft]</th>\n",
              "      <th>$w_x h_x^k$</th>\n",
