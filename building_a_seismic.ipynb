    {
      "cell_type": "markdown",
      "id": "061c638e",
      "metadata": {},
      "source": [
        "#### East-West Direction"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "93fa399c",
      "metadata": {},
      "source": [
        "Most likely, the shear walls in the E-W direction will be governed by a rigid diaphragm assumption. "
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 49,
      "id": "5ab1b559",
      "metadata": {},
      "outputs": [],
      "source": [
        "# Plan dimensions\n",
        "l_AA__AB = (30 + 9 / 12) * ft\n",
        "l_AB__AC = (5 + 6 / 12) * ft\n",
        "l_AC__AD = (30 + 9 / 12) * ft\n",
        "\n",
        "d_trib = L_floor"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 50,
      "id": "d2c7e086",
      "metadata": {},
      "outputs": [],
      "source": [
        "# Wall tributary widths\n",
        "t_w__AB = l_AA__AB + l_AB__AC / 2\n",
        "t_w__AC = l_AB__AC / 2 + l_AC__AD"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 51,
      "id": "57f82d47",
      "metadata": {},
      "outputs": [],
      "source": [
        "# Wall segment lengths\n",
        "l_AB__1 = 26\n",
        "l_AB__2 = 13.25\n",
        "l_AB__3 = 9\n",
        "l_AB__4 = 12\n",
        "l_AB__5 = 11\n",
        "l_AB__6 = 29.75\n",
        "l_AB__7 = 12.75\n",
        "l_AB__8 = 16.25\n",
        "l_AB__9 = 13.75\n",
        "\n",
        "l_AC__1 = 17.25\n",
        "l_AC__2 = 23\n",
        "l_AC__3 = 22.5\n",
        "l_AC__4 = 26\n",
        "l_AC__5 = 11.25\n",
        "l_AC__6 = 7\n",
        "l_AC__7 = 6.75\n",
        "l_AC__8 = 10.25\n",
        "l_AC__9 = 25.25\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "93676613",
      "metadata": {},
      "source": [
        "Shear wall shear forces are tabulated in \\autoref{tab:shear_wall_forces_roof_ew}, \\autoref{tab:shear_wall_forces_level4_ew}, \\autoref{tab:shear_wall_forces_level3_ew}, and \\autoref{tab:shear_wall_forces_level2_ew}. \\\n",
        "\n",
        "Note that the cumulative shear force, $F_{x,cum}$, is cumulative from the Roof downwards. For example, Level 3 includes the shear forces from the Roof, Level 4, and Level 3."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 52,
      "id": "eefdf587",
      "metadata": {},
      "outputs": [],
      "source": [
        "levels = [\"Roof\", \"Level 4\", \"Level 3\", \"Level 2\"]\n",
        "walls = [\n",
        "    \"A-B\",\n",
        "    \"A-C\",\n",
        "]\n",
        "\n",
        "index = pd.MultiIndex.from_product([levels, walls], names=[\"Level\", \"Wall\"])\n",
        "\n",
        "diaphragm_flexible_ew = pd.DataFrame(index=index)\n",
        "diaphragm_flexible_ew.loc[\"Roof\", \"tributary weight\"] = float(f_p__roof)\n",
        "diaphragm_flexible_ew.loc[\"Level 4\", \"tributary weight\"] = float(f_p__4)\n",
        "diaphragm_flexible_ew.loc[\"Level 3\", \"tributary weight\"] = float(f_p__3)\n",
        "diaphragm_flexible_ew.loc[\"Level 2\", \"tributary weight\"] = float(f_p__2)\n",
        "\n",
        "# Add wall tributary lengths to df\n",
        "wall_trib_widths = {\n",
        "    \"A-B\": float(t_w__AB),\n",
        "    \"A-C\": float(t_w__AC),\n",
        "}\n",
        "diaphragm_flexible_ew[\"tributary width\"] = diaphragm_flexible_ew.index.get_level_values(\n",
        "    \"Wall\"\n",
        ").map(wall_trib_widths)\n",
        "diaphragm_flexible_ew[\"tributary depth\"] = float(d_trib)\n",
        "diaphragm_flexible_ew[\"tributary area\"] = (\n",
        "    diaphragm_flexible_ew[\"tributary depth\"] * diaphragm_flexible_ew[\"tributary width\"]\n",
        ")\n",
        "level_area = diaphragm_flexible_ew[\"tributary area\"].sum() / 4\n",
        "\n",
        "# Ensure that the calculated areas from earlier and tributary areas match\n",
        "assert np.isclose(level_area, float(A_level)), (\n",
        "    f\"Shear wall tributary areas {level_area} and level area {A_level} do not match up. Ensure you are including all areas in your calculations\"\n",
        ")\n",
        "\n",
        "diaphragm_flexible_ew[\"floor shear\"] = (\n",
        "    diaphragm_flexible_ew[\"tributary area\"] * diaphragm_flexible_ew[\"tributary weight\"]\n",
        ")\n",
        "diaphragm_flexible_ew[\"cumulative shear\"] = diaphragm_flexible_ew.groupby(level=\"Wall\")[\n",
        "    \"floor shear\"\n",
        "].cumsum()\n",
        "\n",
        "l_AB = (\n",
        "    l_AB__1\n",
        "    + l_AB__2\n",
        "    + l_AB__3\n",
        "    + l_AB__4\n",
        "    + l_AB__5\n",
        "    + l_AB__6\n",
        "    + l_AB__7\n",
        "    + l_AB__8\n",
        "    + l_AB__9\n",
        ")\n",
        "l_AC = (\n",
        "    l_AC__1\n",
        "    + l_AC__2\n",
        "    + l_AC__3\n",
        "    + l_AC__4\n",
        "    + l_AC__5\n",
        "    + l_AC__6\n",
        "    + l_AC__7\n",
        "    + l_AC__8\n",
        "    + l_AC__9\n",
        ")\n",
        "wall_lengths = {\n",
        "    \"A-B\": l_AB,\n",
        "    \"A-C\": l_AC,\n",
        "}\n",
        "diaphragm_flexible_ew[\"wall length\"] = diaphragm_flexible_ew.index.get_level_values(\n",
        "    \"Wall\"\n",
        ").map(wall_lengths)\n",
        "diaphragm_flexible_ew[\"unit shear\"] = (\n",
        "    diaphragm_flexible_ew[\"cumulative shear\"] / diaphragm_flexible_ew[\"wall length\"]\n",
        ")\n",
        "load_factor = 0.7\n",
        "diaphragm_flexible_ew[\"factored unit shear\"] = (\n",
        "    diaphragm_flexible_ew[\"unit shear\"] * load_factor\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 53,
      "id": "470c4d46",
      "metadata": {},
      "outputs": [],
      "source": [
        "# Rename columns for display with LaTeX formatting for units and subscripts/superscripts\n",
        "df_display = diaphragm_flexible_ew[\n",
        "    diaphragm_flexible_ew.columns.difference(\n",
        "        [\"tributary width\", \"tributary depth\"], sort=False\n",
        "    )\n",
        "].copy()\n",
        "column_name_map = {\n",
        "    \"tributary weight\": \"$w_{trib}$ [psf]\",\n",
        "    # \"tributary width\": \"$l_{trib}$ [ft]\",\n",
        "    # \"tributary depth\": \"$d_{trib}$ [ft]\",\n",
        "    \"tributary area\": \"$A$ [ft$^2$]\",\n",
        "    \"floor shear\": \"$F_x$ [lbf]\",\n",
        "    \"cumulative shear\": \"$F_{x,cum}$ [lbf]\",\n",
        "    \"wall length\": \"$l_{wall}$ [ft]\",\n",
        "    \"unit shear\": \"$v$ [plf]\",\n",
        "    \"factored unit shear\": \"$0.7 v$ [lbf]\",\n",
        "}\n",
        "df_display.rename(columns=column_name_map, errors=\"raise\", inplace=True)"
      ]
    },
